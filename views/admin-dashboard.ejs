<script>
document.addEventListener("DOMContentLoaded", function () {

  const emailInput = document.getElementById("customerEmail");
 const productSelect = document.getElementById("productSelect");

  const frequencySelect = document.getElementById("frequencySelect");
  const quantityInput = document.getElementById("quantityInput");
  const totalField = document.getElementById("calculatedTotal");
  const deliveryCheckboxes = document.querySelectorAll('input[name="deliveryDays"]');
  const periodRadios = document.querySelectorAll('input[name="period"]');

  let basePrice = 0;
  let allowedDays = 0;

  /* ===============================
     EMAIL AUTOFILL
  =============================== */
  emailInput.addEventListener("change", async function () {

    const email = this.value.trim();
    if (!email) return;

    try {
      const res = await fetch(`/admin/get-customer-by-email?email=${encodeURIComponent(email)}`);
      const data = await res.json();

      if (!data || !data.exists || !data.customer) return;

      const c = data.customer;

      document.getElementById("customerName").value = c.name || "";
      document.getElementById("customerContact").value = c.contact || "";

      if (c.address) {
        document.getElementById("addressLine1").value = c.address.line1 || "";
        document.getElementById("addressLine2").value = c.address.line2 || "";
        document.getElementById("addressCity").value = c.address.city || "";
        document.getElementById("addressState").value = c.address.state || "";
        document.getElementById("addressPincode").value = c.address.pincode || "";
        document.getElementById("addressCountry").value = c.address.country || "";
      }

    } catch (err) {
      console.error("Autofill error:", err);
    }

  });

  /* ===============================
     DELIVERY DAY LIMIT
  =============================== */
  frequencySelect.addEventListener("change", function () {

    const selected = frequencySelect.options[frequencySelect.selectedIndex];
    const isMonthly = selected?.dataset.monthly === "true";

    allowedDays = Number(selected?.dataset.days || 0);

    // reset all checkboxes
    deliveryCheckboxes.forEach(cb => cb.checked = false);

    // Update period labels: show weeks for weekly, months for monthly
    document.querySelectorAll(".period-label").forEach(label => {
      label.textContent = isMonthly ? label.dataset.months : label.dataset.weeks;
    });

    fetchVariantPrice();
    calculateTotal();
  });

  // Only ONE listener for delivery days
  deliveryCheckboxes.forEach(cb => {
    cb.addEventListener("change", function () {

      const checkedCount = [...deliveryCheckboxes].filter(c => c.checked).length;

      if (checkedCount > allowedDays) {
        this.checked = false;
        const freqLabel = frequencySelect.options[frequencySelect.selectedIndex]?.text || "";
        alert(`"${freqLabel}" requires exactly ${allowedDays} delivery day(s). Please select only ${allowedDays}.`);
      }
    });
  });

  /* ===============================
     FETCH PRICE
  =============================== */
  async function fetchVariantPrice() {

    const product = productSelect.value.trim();

    const frequency = frequencySelect.value;

    if (!product || !frequency) {
      basePrice = 0;
      totalField.value = "";
      return;
    }

    try {
      const res = await fetch(
        `/api/get-variant-price?product=${encodeURIComponent(product)}&frequency=${encodeURIComponent(frequency)}`
      );

      const data = await res.json();

      console.log("Price API response:", data);

      if (data && data.price !== undefined) {
        basePrice = Number(data.price);
      } else {
        basePrice = 0;
      }

      calculateTotal();

    } catch (err) {
      console.error("Price fetch error:", err);
      basePrice = 0;
      totalField.value = "";
    }
  }

  /* ===============================
     TOTAL CALCULATION
     Weekly : price × qty × period(weeks) × deliveries-per-week
     Monthly: price × qty × months        × deliveries-per-month
              months = period / 4   (4W=1M, 8W=2M, 12W=3M)
  =============================== */
  function calculateTotal() {

    const quantity = Number(quantityInput.value) || 0;

    const selectedOption = frequencySelect.options[frequencySelect.selectedIndex];
    const multiplier  = Number(selectedOption?.dataset.multiplier || 0);
    const isMonthly   = selectedOption?.dataset.monthly === "true";

    const selectedPeriod = document.querySelector('input[name="period"]:checked');
    const period = Number(selectedPeriod?.value || 0);   // always in weeks (4 / 8 / 12)

    if (!basePrice || !quantity || !period || !multiplier) {
      totalField.value = "";
      return;
    }

    let totalDeliveries;
    if (isMonthly) {
      const months = period / 4;          // 4W→1, 8W→2, 12W→3
      totalDeliveries = months * multiplier;
    } else {
      totalDeliveries = period * multiplier;   // weeks × deliveries/week
    }

    const total = basePrice * quantity * totalDeliveries;

    totalField.value = "₹ " + total.toFixed(2);

    // Debug
    console.log({ isMonthly, basePrice, quantity, period, multiplier, totalDeliveries, total });
  }

  /* ===============================
     EVENT BINDINGS
  =============================== */
  productSelect.addEventListener("change", fetchVariantPrice);

  quantityInput.addEventListener("input", calculateTotal);
  periodRadios.forEach(r => r.addEventListener("change", calculateTotal));

});


/* MODAL FUNCTIONS */
function openManualSubscriptionModal() {
  document.getElementById("manualSubscriptionModal").style.display = "block";
}

function closeManualSubscriptionModal() {
  document.getElementById("manualSubscriptionModal").style.display = "none";
}
</script>
