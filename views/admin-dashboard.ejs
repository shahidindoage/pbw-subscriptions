<script>
document.getElementById("exportByRangeBtn").addEventListener("click", async () => {

  const btn = document.getElementById("exportByRangeBtn");
  const spinner = document.getElementById("rangeSpinner");
  const btnText = document.getElementById("rangeBtnText");
  const range = document.getElementById("exportRange").value;

  // 🔄 Show loading
  spinner.style.display = "inline";
  btnText.innerText = "Preparing ZIP...";
  btn.disabled = true;

  try {

    const res = await fetch("/admin/export-invoices-by-range", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ range })
    });

    if (!res.ok) {
      throw new Error("Export failed");
    }

    const blob = await res.blob();
    const url = window.URL.createObjectURL(blob);

    const a = document.createElement("a");
    a.href = url;

    // Get filename from backend
    const contentDisposition = res.headers.get("content-disposition");

    let fileName = "Invoices.zip";

    if (contentDisposition) {
      const match = contentDisposition.match(/filename="?(.+?)"?$/);
      if (match && match[1]) {
        fileName = match[1];
      }
    }

    a.download = fileName;

    document.body.appendChild(a);
    a.click();
    a.remove();

    window.URL.revokeObjectURL(url);

  } catch (err) {
    alert("Export failed");
  }

  // 🔁 Reset
  spinner.style.display = "none";
  btnText.innerText = "Export Range";
  btn.disabled = false;

});
</script>


