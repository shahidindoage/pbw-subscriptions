<!DOCTYPE html>
<html>
<head>
  <title>Admin Panel</title>
  <style>
  body {
    margin: 0;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    background: #f3f4f6;
    color: #111827;
  }

  .container {
    display: flex;
    height: 100vh;
  }

  /* ===== Sidebar ===== */
  .sidebar {
    width: 240px;
    background: #111827;
    color: #fff;
    padding: 20px;
    box-sizing: border-box;
  }

  .sidebar h3 {
    margin-top: 0;
    margin-bottom: 20px;
    font-size: 18px;
    font-weight: 600;
  }

  .sidebar a {
    display: block;
    color: #d1d5db;
    text-decoration: none;
    padding: 10px 12px;
    margin-bottom: 6px;
    border-radius: 6px;
    transition: background 0.2s, color 0.2s;
    font-size: 14px;
  }

  .sidebar a.active,
  .sidebar a:hover {
    background: #1f2937;
    color: #ffffff;
  }

  .sidebar a:last-child {
    margin-top: 20px;
    background: #7c2d12;
    color: #fff;
  }

  .sidebar a:last-child:hover {
    background: #9a3412;
  }

  /* ===== Content ===== */
  .content {
    flex: 1;
    padding: 24px;
    overflow-y: auto;
  }

  h2 {
    margin-top: 0;
    font-size: 22px;
    margin-bottom: 16px;
  }

  /* ===== Search ===== */
  #adminSearch {
    border: 1px solid #d1d5db;
    border-radius: 6px;
    outline: none;
    font-size: 14px;
  }

  #adminSearch:focus {
    border-color: #2563eb;
  }

  /* ===== Tables ===== */
  table {
    width: 100%;
    border-collapse: collapse;
    background: #ffffff;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
  }

  th {
    background: #5e8046;
    color: white;
    text-align: left;
    font-size: 13px;
    font-weight: 600;
    padding: 10px;
    border-bottom: 1px solid #e5e7eb;
    white-space: nowrap;
  }

  td {
    font-size: 13px;
    padding: 10px;
    border-bottom: 1px solid #e5e7eb;
    vertical-align: middle;
  }

  tr:hover td {
    background: #f9fafb;
  }

  /* ===== Buttons ===== */
  button {
    padding: 6px 10px;
    font-size: 12px;
    border-radius: 5px;
    border: 1px solid #d1d5db;
    background: #ffffff;
    cursor: pointer;
    transition: all 0.2s;
  }

  button:hover {
    background: #f3f4f6;
  }

  button[type="submit"] {
    background: #2563eb;
    color: #fff;
    border: none;
    width: 85px;
  }

  button[type="submit"]:hover {
    background: #1d4ed8;
  }

  /* Danger buttons (Cancel / Logout) */
  form[action*="cancel"] button,
  .sidebar a[href*="logout"] {
    background: #dc2626;
    color: #fff;
    border: none;
  }

  form[action*="cancel"] button:hover {
    background: #b91c1c;
  }

  /* ===== Select ===== */
  select {
    padding: 6px;
    font-size: 13px;
    border-radius: 5px;
    border: 1px solid #d1d5db;
    background: #fff;
  }

  /* ===== Modals ===== */
  #ordersModal > div,
  #addressModal > div {
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
  }

  /* ===== Password text ===== */
  .password-text {
    font-family: monospace;
    letter-spacing: 1px;
  }

  /* ===== Status emphasis ===== */
  strong {
    text-transform: capitalize;
  }
  .action-cell {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  align-items: center;
}

.action-form {
  display: inline;
}

.btn {
  padding: 6px 10px;
  font-size: 12px;
  border-radius: 6px;
  border: none;
  cursor: pointer;
  white-space: nowrap;
  transition: background 0.2s, opacity 0.2s;
}

/* Button colors */
.btn-success {
  background: #16a34a;
  color: #fff;
}
.btn-success:hover { background: #15803d; }

.btn-warning {
  background: #f59e0b !important;
  color: #fff;
}
.btn-warning:hover { background: #d97706; }

.btn-danger {
  background: #dc2626 !important;
  color: #fff;
}
.btn-danger:hover { background: #b91c1c; }

.btn-secondary {
  background: green;
  color: #ffffff;
}
.btn-secondary:hover { background: #d1d5db; }
/* ===== Overlay ===== */
#manualSubscriptionModal{
  display:none;
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.45);
  backdrop-filter: blur(2px);
  z-index:10000;
}

/* ===== Modal Box ===== */
.manual-modal-box{
  background:#fff;
  max-width:1000px;
  margin:30px auto;
  padding:20px 22px;
  border-radius:10px;
  box-shadow:0 15px 40px rgba(0,0,0,.12);
  max-height:90vh;
  overflow-y:auto;
  font-family:system-ui,-apple-system,Segoe UI,Roboto;
}

/* ===== Header ===== */
.manual-modal-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:15px;
}

.manual-modal-header h3{
  font-size:16px;
  font-weight:600;
  margin:0;
}

.manual-close{
  background:#f1f1f1;
  border:none;
  width:28px;
  height:28px;
  border-radius:6px;
  cursor:pointer;
  font-size:14px;
}

.manual-close:hover{
  background:#e74c3c;
  color:#fff;
}

/* ===== Compact Grid ===== */
.manual-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;
}

/* ===== Inputs ===== */
.manual-grid input,
.manual-grid select{
  padding:7px 10px;
  font-size:13px;
  border-radius:6px;
  border:1px solid #ddd;
  transition:.2s;
}

.manual-grid input:focus,
.manual-grid select:focus{
  border-color:#2563eb;
  outline:none;
  box-shadow:0 0 0 2px rgba(37,99,235,.1);
}

/* ===== Section Title ===== */
.section-title{
  font-size:12px;
  font-weight:600;
  margin:12px 0 6px;
  color:#555;
}

/* ===== Frequency Pills ===== */
#frequencySelect{
  background:#f8f9fb;
}

/* ===== Period Radios Compact ===== */
.period-group{
  display:flex;
  gap:14px;
  font-size:12px;
}

.period-group input{
  accent-color:#2563eb;
}

/* ===== Delivery Compact Buttons ===== */
#deliveryDaysWrapper {
  display:flex;
  flex-wrap:wrap;
  gap:6px;
}

#deliveryDaysWrapper label{
  padding:5px 12px;
  border-radius:20px;
  background:#f3f4f6;
  font-size:12px;
  cursor:pointer;
  transition:all .2s ease;
  display:flex;
  align-items:center;
}

#deliveryDaysWrapper input{
  display:none;
}

/* 🔥 When Checked */
#deliveryDaysWrapper input:checked + span{
  color:#fff;
}

#deliveryDaysWrapper input:checked + span::before{
  content:"";
}

/* IMPORTANT: Change LABEL background */
#deliveryDaysWrapper input:checked + span{
  background:#2563eb;
  padding:5px 12px;
  border-radius:20px;
}

/* Hover */
#deliveryDaysWrapper label:hover{
  background:#e5e7eb;
}

/* ===== Total Highlight ===== */
#calculatedTotal{
  background:#f0f7ff;
  border:1px solid #2563eb;
  font-weight:600;
  color:#2563eb;
}

/* ===== Submit Button ===== */
.manual-submit{
  background:#2563eb;
  color:#fff;
  border:none;
  padding:7px 16px;
  font-size:13px;
  border-radius:6px;
  cursor:pointer;
  transition:.2s;
}

.manual-submit:hover{
  background:#1e40af;
}
.invoice-actions-card {
  
 
  margin-bottom: 15px;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
      justify-content: space-between;
  align-items: center;
}

.range-group,
.email-group {
  display: flex;
  gap: 10px;
  align-items: center;
}

.action-btn {
  padding: 10px 18px;
  border-radius: 8px;
  border: none;
  font-weight: 500;
  font-size: 14px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 6px;
  min-height: 20px;
}



.primary {
  background: #0d6efd;
  color: white;
}
.primary:hover{
   background: #2a73e0;
  color: white;
}
.success {
  background: #198754;
  color: white;
}
.success:hover {
  background: #228557;
  color: white;
}
.danger {
  background: #dc3545;
  color: white;
}
.danger:hover {
  background: #ce3e4d;
  color: white;
}
.range-select,
.email-input {
  height: 40px;
  padding: 0 12px;
  border-radius: 8px;
  border: 1px solid #ddd;
  font-size: 14px;
  min-width: 180px;
}

.email-input {
  min-width: 240px;
}

.spinner {
  display: none;
  font-size: 13px;
}

button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}
.last-group {
    display: flex;
    gap: 20px;
}
</style>

</head>
<body>

<div class="container">

  <!-- SIDEBAR -->
  <div class="sidebar">
    <h3>Admin Panel</h3>

    <a href="/admin/customers" class="<%= page === 'customers' ? 'active' : '' %>">
      Customers
    </a>

    <a href="/admin/subscriptions" class="<%= page === 'subscriptions' ? 'active' : '' %>">
      Subscriptions
    </a>

<a href="/admin/dashboard?page=shopify-orders"
   class="<%= page === 'shopify-orders' ? 'active' : '' %>">
  Shopify Orders
</a>

<a href="/admin/dashboard?page=invoices"
   class="<%= page === 'invoices' ? 'active' : '' %>">
  Invoices
</a>


    <br>
    <a href="/admin/logout">Logout</a>
  </div>

  <!-- CONTENT -->
  <div class="content">
<div style="margin-bottom:15px;">
  <input
    type="text"
    id="adminSearch"
    placeholder="Search by email, product, subscription ID, order ID…"
    style="padding:8px; width:300px; max-width:100%;"
    onkeyup="filterTable()"
  />
</div>

   <% if (page === "customers") { %>
  <h2>Customers</h2>

  <table id="adminTable">
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Contact</th>
      <th>Address</th>
      <th>Total Subs</th>
      <th>Active Subs</th>
    </tr>

    <% customers.forEach(c => { 
      const active = c.subscriptions.filter(s => s.status === "active").length;
    %>
      <tr>
        <td><%= c.name %></td>
        <td><%= c.email %></td>
        <td><%= c.contact || "-" %></td>

        <!-- Address -->
        <td>
  <% if (c.address) { %>
    <button
      type="button"
      onclick='showAddress(<%- JSON.stringify(c.address) %>)'
      style="padding:4px 8px; cursor:pointer;"
    >
      View
    </button>
  <% } else { %>
    -
  <% } %>
</td>


      

        <td><%= c.subscriptions.length %></td>
        <td><%= active %></td>
      </tr>
    <% }) %>
  </table>
<% } %>


  <% if (page === "subscriptions") { %>
  <div style="display:flex; justify-content:space-between; align-items:center;">
    <h2>Subscriptions</h2>

    <button class="btn btn-success"
            onclick="openManualSubscriptionModal()">
      + Manual Subscription
    </button>
  </div>

  <table id="adminTable">
    <tr>
      <th>Subscription ID</th>
      <th>Customer</th>
      <th>Product</th>
      <!-- <th>Variant</th> -->
      <th>Frequency</th>
      <th>Qty</th>
      <th>Delivery Days</th>
      <th>Status</th>
      <!-- <th>One-Time</th> -->
      <th>Total</th>
      <th>Delivery Fee</th>
      <th>	Subscription Start</th>
      <th>Next Shipping</th>
      <th>End Date</th>
      
      <th>Actions</th>
    </tr>

    <% subscriptions.forEach(s => { %>
      <tr>
        <td><%= s.id %></td>

        <td><%= s.customer.email %></td>

        <td><%= s.product %></td>

        <!-- <td><%= s.variantId || "-" %></td> -->

        <td><%= s.frequency %></td>

        <td><%= s.quantity %></td>

        <td><%= s.deliveryDays || "-" %></td>

        <td><strong><%= s.status %></strong></td>

        <!-- <td><%= s.isOneTimePurchase ? "Yes" : "No" %></td> -->

        <td>₹<%= s.totalAmount %></td>

        <td>₹<%= s.deliveryFee %></td>
<td><%= new Date(s.createdAt).toLocaleString("en-IN", {
      timeZone: "Asia/Kolkata",
      day: "2-digit",
      month: "short",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
      hour12: true
  })%></td>

        <td>
          <%= s.nextShippingDate
            ? new Date(s.nextShippingDate).toLocaleString("en-IN", {
        timeZone: "Asia/Kolkata",
        day: "2-digit",
        month: "short",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
        hour12: true
      })
            : "-" %>
        </td>

        <td>
          <%= s.subscriptionEndDate
            ? new Date(s.subscriptionEndDate).toLocaleString("en-IN", {
        timeZone: "Asia/Kolkata",
        day: "2-digit",
        month: "short",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
        hour12: true
      })
            : "-" %>
        </td>

        
     <td class="action-cell">
        <button type="button"
            class="btn btn-secondary"
            onclick="openOrdersModal('<%= s.id %>')">
      View Orders
    </button>
  <% if (s.status === "active") { %>

    <form method="POST"
          action="/admin/subscription/<%= s.id %>/action"
          class="action-form">
      <input type="hidden" name="action" value="stop">
      <button type="submit" class="btn btn-warning">Stop</button>
    </form>

  

    <form method="POST"
          action="/admin/subscription/<%= s.id %>/action"
          class="action-form">
      <input type="hidden" name="action" value="cancel">
      <button type="submit" class="btn btn-danger">Cancel</button>
    </form>

  <% } else if (s.status === "stopped") { %>

    <form method="POST"
          action="/admin/subscription/<%= s.id %>/action"
          class="action-form">
      <input type="hidden" name="action" value="resume">
      <button type="submit" class="btn btn-success">Resume</button>
    </form>

    <button type="button"
            class="btn btn-secondary"
            onclick="openOrdersModal('<%= s.id %>')">
      View Orders
    </button>

    <form method="POST"
          action="/admin/subscription/<%= s.id %>/action"
          class="action-form">
      <input type="hidden" name="action" value="cancel">
      <button type="submit" class="btn btn-danger">Cancel</button>
    </form>

  <% } else { %>
    -
  <% } %>
</td>

      </tr>
    <% }) %>
  </table>
<% } %>



   <% if (page === "shopify-orders") { %>
  <h2>Shopify Orders</h2>

  <table id="adminTable">
    <tr>
      <th>Shopify Order ID</th>
      <th>Subscription ID</th>
      <th>Customer</th>
      <th>Product</th>
      
      <th>Frequency</th>
      
      <th>Shipping Date</th>
      <th>Status</th>
      <th>Created</th>
      <th>Action</th>
    </tr>

    <% shopifyOrders.forEach(o => { %>
      <tr>
        <!-- Shopify Order ID -->
        <td>
          <% if (o.shopifyOrderId) { %>
           PBW<%= o.order_number %>
          <% } else { %>
            -
          <% } %>
        </td>
         <!-- ✅ Subscription ID -->
        <td style="font-size:12px;">
          <%= o.subscription.id %>
        </td>
        <td><%= o.subscription.customer.email %></td>
        <td><%= o.subscription.product %></td>

       

        <!-- ✅ Frequency -->
        <td>
          <%= o.subscription.frequency %>
        </td>

        

        <td><%= o.shippingDate.toDateString() %></td>

        <td><strong><%= o.status %></strong></td>

        <td><%= o.createdAt.toDateString() %></td>



        <td>
          <form method="POST" action="/admin/shopify-order/<%= o.id %>/status">
            <select name="status" onchange="this.form.submit()">
              <option value="created" <%= o.status === "created" ? "selected" : "" %>>Created</option>
              <option value="processing" <%= o.status === "processing" ? "selected" : "" %>>Processing</option>
              <option value="shipped" <%= o.status === "shipped" ? "selected" : "" %>>Shipped</option>
              <option value="delivered" <%= o.status === "delivered" ? "selected" : "" %>>Delivered</option>
              <option value="cancelled" <%= o.status === "cancelled" ? "selected" : "" %>>Cancelled</option>
            </select>
          </form>
        </td>
      </tr>
    <% }) %>
  </table>
<% } %>

<% if (page === "invoices") { %>
  <h2>Invoices</h2>
<div class="invoice-actions-card">

  <div class="action-row">

    <!-- Bulk Download -->
    <button id="bulkDownloadBtn" class="action-btn danger">
      <span id="btnText">Download Selected</span>
      <span id="spinner" class="spinner">⏳</span>
    </button>
<div class="last-group">
  <!-- Date Range -->
    <div class="range-group">
      <select id="exportRange" class="range-select">
        <option value="7">Last 7 Days</option>
        <option value="14">Last 14 Days</option>
        <option value="1m">Last 1 Month</option>
        <option value="6m">Last 6 Months</option>
      </select>

    <button id="exportByRangeBtn" class="action-btn primary">
  <span id="rangeBtnText">Export Range</span>
  <span id="rangeSpinner" class="spinner">⏳</span>
</button>

    </div>

    <!-- Email Export -->
    <div class="email-group">
      <input type="email" id="exportEmail" 
             placeholder="Filter by email (optional)" 
             class="email-input"/>

      <button id="emailExportBtn" class="action-btn success">
        <span id="btnText2">Export</span>
        <span id="spinner2" class="spinner">⏳</span>
      </button>
    </div>


</div>
  
  </div>

</div>


  <table id="adminTable">
    <tr>
      <th>
  <input type="checkbox" id="selectAll">
</th>
      <th>Shopify Order ID</th>
      <th>Subscription ID</th>
      <th>Customer</th>
     <th>Shipping Date</th> 
      <th>Status</th>
      <th colspan="2" style="text-align: center;">Invoice Management</th>
    </tr>

    <% invoices.forEach(o => { %>
      <tr>
<td>
  <input 
    type="checkbox"
    class="invoiceCheckbox"
    value="<%= o.id %>"
    <%= o.status === "created" ? "disabled" : "" %>
  >
</td>


        <!-- Shopify Order -->
        <td>
          <% if (o.shopifyOrderId) { %>
            PBW<%= o.order_number %>
          <% } else { %>
            -
          <% } %>
        </td>

        <!-- Subscription -->
        <td><%= o.subscription.id %></td>

        <!-- Customer -->
        <td><%= o.subscription.customer.email %></td>
<td><strong><%= o.shippingDate.toDateString() %></strong></td>
        <!-- Status -->
        <td><strong><%= o.status %></strong></td>

        <!-- Invoice Download -->
  <td style="text-align: center;">
  <% if (o.status === "created") { %>

      <span style="color:orange; font-weight:500;text-align: center;">
        Unfulfilled Order
      </span>

  <% } else if (o.invoiceUrl) { 
       const viewUrl = o.invoiceUrl.replace("dl=0", "raw=1");
       const downloadUrl = o.invoiceUrl.replace("dl=0", "dl=1");
  %>

    <div style="display:flex; gap:10px; align-items:center; justify-content:center;">

      <!-- View Icon -->
      <a href="<%= viewUrl %>" target="_blank" title="View Invoice">
        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25"
             fill="#6c757d" viewBox="0 0 24 24"
             style="cursor:pointer;">
          <path d="M12 5c-7 0-11 7-11 7s4 7 11 7 11-7 11-7-4-7-11-7zm0 
                   12a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 
                   0 6 3 3 0 0 0 0-6z"/>
        </svg>
      </a>

      <!-- Download Icon -->
      <a href="<%= downloadUrl %>" title="Download Invoice">
        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25"
             fill="red" viewBox="0 0 24 24"
             style="cursor:pointer;">
          <path d="M12 16l4-5h-3V4h-2v7H8l4 
                   5zm-7 2v2h14v-2H5z"/>
        </svg>
      </a>

    </div>

  <% } else { %>
      <span class="text-muted">Not Generated</span>
  <% } %>
</td>






      </tr>
    <% }) %>

  </table>
<% } %>

  </div>
</div>

<script>
document.getElementById("bulkDownloadBtn").addEventListener("click", async () => {

  const selected = Array.from(document.querySelectorAll(".invoiceCheckbox:checked"))
                        .map(cb => cb.value);

  if (!selected.length) {
    alert("Select at least one invoice");
    return;
  }

  // Show loading
  document.getElementById("spinner").style.display = "inline";
  document.getElementById("btnText").innerText = "Preparing ZIP...";
  document.getElementById("bulkDownloadBtn").disabled = true;

  try {
    const res = await fetch("/admin/export-invoices", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ ids: selected })
    });

    const blob = await res.blob();

    const url = window.URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;

    // dynamic filename from response header
    const disposition = res.headers.get("Content-Disposition");
    const match = disposition && disposition.match(/filename="?(.+)"?/);
    a.download = match ? match[1] : "invoices.zip";

    a.click();
    window.URL.revokeObjectURL(url);

  } catch (err) {
    alert("Download failed");
  }

  // Reset button
  document.getElementById("spinner").style.display = "none";
  document.getElementById("btnText").innerText = "Download Selected (ZIP)";
  document.getElementById("bulkDownloadBtn").disabled = false;
});
</script>

<script>
const selectAll = document.getElementById("selectAll");

selectAll.addEventListener("change", () => {
  const checkboxes = document.querySelectorAll(".invoiceCheckbox:not(:disabled)");
  checkboxes.forEach(cb => cb.checked = selectAll.checked);
});

// Handle individual checkbox change
document.addEventListener("change", function(e) {
